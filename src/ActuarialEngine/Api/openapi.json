{
  "openapi": "3.1.1",
  "info": {
    "title": "PAS.ActuarialEngine.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/policies/{id}": {
      "get": {
        "tags": [
          "Policies"
        ],
        "description": "Get the policy identified by 'id'.",
        "operationId": "GetPolicy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPolicyResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/policies/{id}/valuation": {
      "post": {
        "tags": [
          "Policies"
        ],
        "description": "Try to perform valuation of the insurance policy identified by 'id' up to the current date.",
        "operationId": "PerformPolicyValuation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerformPolicyValuationResult"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPolicyResult": {
        "required": [
          "id",
          "currencyId",
          "latestValuationDate",
          "mathReserveTotalInEur",
          "mathReserveTotalInPolicyCurrency",
          "mathReserveByFunds",
          "warningMessage"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "currencyId": {
            "type": "string"
          },
          "latestValuationDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "mathReserveTotalInEur": {
            "type": "number",
            "format": "decimal"
          },
          "mathReserveTotalInPolicyCurrency": {
            "type": "number",
            "format": "decimal"
          },
          "mathReserveByFunds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/GetPolicyResultMathReserve"
            }
          },
          "warningMessage": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GetPolicyResultMathReserve": {
        "required": [
          "fundId",
          "units",
          "amountInPolicyCurrency",
          "amountInFundCurrency",
          "amountInEur"
        ],
        "type": "object",
        "properties": {
          "fundId": {
            "type": "string",
            "format": "uuid"
          },
          "units": {
            "type": "number",
            "format": "decimal"
          },
          "amountInPolicyCurrency": {
            "type": "number",
            "format": "decimal"
          },
          "amountInFundCurrency": {
            "type": "number",
            "format": "decimal"
          },
          "amountInEur": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "PerformPolicyValuationResult": {
        "required": [
          "generatedEvents",
          "warningMessage",
          "lastestValuationDate",
          "mathReserveTotalInEur",
          "mathReserveTotalInPolicyCurrency"
        ],
        "type": "object",
        "properties": {
          "generatedEvents": {
            "type": "integer",
            "format": "int32"
          },
          "warningMessage": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastestValuationDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "mathReserveTotalInEur": {
            "type": "number",
            "format": "decimal"
          },
          "mathReserveTotalInPolicyCurrency": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Policies"
    }
  ]
}