{
  "openapi": "3.1.1",
  "info": {
    "title": "PAS.PolicyAdmin.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/policies": {
      "post": {
        "tags": [
          "Policies"
        ],
        "description": "Create a new insurance policy.",
        "operationId": "CreatePolicy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePolicyCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePolicyResult"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/policies/{id}": {
      "get": {
        "tags": [
          "Policies"
        ],
        "description": "Get the insurance policy identified by 'id'.",
        "operationId": "GetPolicy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPolicyResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/policies/{id}/issue": {
      "post": {
        "tags": [
          "Policies"
        ],
        "description": "Issue the insurance policy identified by 'id'.",
        "operationId": "IssuePolicy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IssuePolicyCommandBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePolicyCommand": {
        "required": [
          "id",
          "premiumDate",
          "currencyId",
          "premiumAmount",
          "premiumAllocations"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "premiumDate": {
            "type": "string",
            "format": "date"
          },
          "currencyId": {
            "type": "string"
          },
          "premiumAmount": {
            "type": "number",
            "format": "decimal"
          },
          "premiumAllocations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatePolicyCommandAllocationItem"
            }
          }
        }
      },
      "CreatePolicyCommandAllocationItem": {
        "required": [
          "fundId",
          "ratio"
        ],
        "type": "object",
        "properties": {
          "fundId": {
            "type": "string",
            "format": "uuid"
          },
          "ratio": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "CreatePolicyResult": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetPolicyResult": {
        "required": [
          "id",
          "status",
          "currencyId",
          "effectiveDate",
          "operations"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/PolicyStatus"
          },
          "currencyId": {
            "type": "string"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetPolicyResultOperation"
            }
          }
        }
      },
      "GetPolicyResultAllocationItem": {
        "required": [
          "fundId",
          "ratio"
        ],
        "type": "object",
        "properties": {
          "fundId": {
            "type": "string",
            "format": "uuid"
          },
          "ratio": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "GetPolicyResultOperation": {
        "required": [
          "$type"
        ],
        "type": "object",
        "oneOf": [
          {
            "$ref": "#/components/schemas/GetPolicyResultOperationPremium"
          },
          {
            "$ref": "#/components/schemas/GetPolicyResultOperationFullSurrender"
          }
        ],
        "discriminator": {
          "propertyName": "$type",
          "mapping": {
            "Premium": "#/components/schemas/GetPolicyResultOperationPremium",
            "FullSurrender": "#/components/schemas/GetPolicyResultOperationFullSurrender"
          }
        }
      },
      "GetPolicyResultOperationFullSurrender": {
        "required": [
          "date",
          "dailySeq",
          "id"
        ],
        "properties": {
          "$type": {
            "enum": [
              "FullSurrender"
            ],
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "dailySeq": {
            "type": "integer",
            "format": "int32"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetPolicyResultOperationPremium": {
        "required": [
          "date",
          "dailySeq",
          "amount",
          "currencyId",
          "allocations",
          "id"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Premium"
            ],
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "dailySeq": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "currencyId": {
            "type": "string"
          },
          "allocations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetPolicyResultAllocationItem"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "IssuePolicyCommandBody": {
        "type": "object",
        "properties": {
          "date": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "PolicyStatus": {
        "enum": [
          "Pending",
          "Issued"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Policies"
    }
  ]
}