        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetValuationListResultItem"
            }
          },
          "hasNextPage": {
            "type": "boolean"
          }
        }
      },
      "GetValuationListResultItem": {
        "required": [
          "date",
          "amountInPolicyCurrency",
          "amountInEur"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "amountInPolicyCurrency": {
            "type": "number",
            "format": "decimal"
          },
          "amountInEur": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
